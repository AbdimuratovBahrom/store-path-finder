msgid "Поиск магазина"
msgstr "Дўкон йўлини топувчи"

msgid "Введите номер или название..."
msgstr "Рақам ёки ном киритинг..."

msgid "Поиск линий электроснабжения магазинов"
msgstr "Дўконлар электр таъминоти линияларини қидириш"

msgid "Выберите блок"
msgstr "Блокни танланг"

msgid "Выберите ряд"
msgstr "Қаторни танланг"

msgid "Выберите магазин"
msgstr "Дўконни танланг"

msgid "Ряды не найдены"
msgstr "Қаторлар топилмади"

msgid "Магазины не найдены"
msgstr "Дўконлар топилмади"

msgid "Путь не найден"
msgstr "Йўл топилмади"

msgid "Блоки 1,2,3"
msgstr "1,2,3-блоклар"

msgid "Показать блоки"
msgstr "Блокларни кўрсатиш"

msgid "Скрыть блоки"
msgstr "Блокларни яшириш"
