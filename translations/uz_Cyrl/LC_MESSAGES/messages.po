msgstr "Рақам ёки номни киритинг..."

msgid "Блоки 1,2,3"
msgstr "1,2,3-блоклар"

msgid "Ничего не найдено"
msgstr "Ҳеч нарса топилмади"

msgid "Гипермаркет"
msgstr "Гипермаркет"
